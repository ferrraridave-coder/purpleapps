# Cloudflare static-asset response headers (Workers static assets, see wrangler.jsonc).
# Screenshots and share images: cache for a week, then revalidate.
# If you replace an image, give the new file a new name so visitors get it at once.
# styles.css and main.js: every HTML page links them as ?v=<content hash>
# (node scripts/stamp-assets.mjs; node scripts/check-site.mjs fails if a hash
# is stale), so they can be cached for a year. HTML stays on Cloudflare's
# default (max-age=0, must-revalidate), so a new hash reaches visitors at once.
# ALWAYS re-run stamp-assets.mjs after editing styles.css or main.js.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/main.js
  Cache-Control: public, max-age=31536000, immutable
